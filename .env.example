# Google Gemini API Key for server-side clinical reasoning & multimodal analysis
GEMINI_API_KEY=

# Central Application Secret (Optional for Render backend proxy)
VITE_CENTRAL_APP_SECRET=
EXPO_PUBLIC_CENTRAL_APP_SECRET=

# Optional Backend URL overrides
VITE_BACKEND_URL=
EXPO_PUBLIC_BACKEND_URL=

# Optional Stripe Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
